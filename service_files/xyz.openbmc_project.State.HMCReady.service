[Unit]
Description=HMC Readiness FeatureReady publisher
Requires=xyz.openbmc_project.EntityManager.service
After=xyz.openbmc_project.EntityManager.service

[Service]
Type=dbus
BusName=xyz.openbmc_project.State.HMCReady
Restart=always
RestartSec=5
# Config is passed as args (override per-platform via a drop-in that resets
# ExecStart). Defaults in the binary match these values.
ExecStart=/usr/libexec/dbus-sensors/hmcreadiness \
    --recovery-path /xyz/openbmc_project/software/FW_RECOVERY_HGX_FW_BMC_0 \
    --recovery-interface xyz.openbmc_project.State.Decorator.OperationalStatus \
    --object-path /xyz/openbmc_project/state/hmc/FW_HMC_0 \
    --feature-type xyz.openbmc_project.State.FeatureReady.FeatureTypes.MC

[Install]
WantedBy=multi-user.target
